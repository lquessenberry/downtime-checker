# QuietEarth (eframe/wgpu wasm) on the GSA staging app. Deploy:
#   fly deploy -c fly.wasm.toml --ha=false -a globalstatus-stage
# wasm-bindgen-cli 0.2.130 wants rustc 1.86+.
FROM rust:1.88-bookworm AS build
WORKDIR /src/rust
# strip=symbols drops wasm custom sections wasm-bindgen needs.
ENV CARGO_PROFILE_RELEASE_STRIP=none
RUN rustup target add wasm32-unknown-unknown \
  && cargo install wasm-bindgen-cli --version 0.2.130 --locked
COPY rust /src/rust
RUN cargo build -p downtime-server --release \
  && cargo build -p downtime-wasm --target wasm32-unknown-unknown --release \
  && cargo build -p downtime-globe-native --lib --target wasm32-unknown-unknown --release \
  && mkdir -p /out/www \
  && wasm-bindgen --target web --out-dir /out/www \
       target/wasm32-unknown-unknown/release/downtime_wasm.wasm \
  && wasm-bindgen --target web --out-dir /out/www \
       target/wasm32-unknown-unknown/release/downtime_globe_native.wasm \
  && cp target/release/downtime-server /out/downtime-server

FROM debian:bookworm-slim
RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=build /out/downtime-server /usr/local/bin/downtime-server
COPY --from=build /out/www /app/www
COPY globalstatus-wasm/index.html /app/www/index.html
COPY globalstatus-wasm/hud.html /app/www/hud.html
COPY globalstatus-wasm/globe.js /app/www/globe.js
COPY rust/crates/globe-native/assets/earth.jpg /app/www/earth.jpg
COPY places.txt world-governments.txt weather.txt institutions.txt \
     world-exchanges.txt service-sites.txt transportation.txt stores.txt \
     communications.txt military.txt shipping.txt food.txt \
     banks-national.txt utilities-national.txt government-extra.txt /app/catalog/
ENV PORT=8080 \
    GSA_BIND=0.0.0.0
EXPOSE 8080
CMD ["downtime-server", "--root", "/app/catalog", "--static", "/app/www", "--bind", "0.0.0.0", "--port", "8080", "--no-lookup"]
