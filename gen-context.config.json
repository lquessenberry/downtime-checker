{
  "output": ".github/copilot-instructions.md",
  "adapters": ["copilot"],
  "strategy": "per-module",
  "srcDirs": [
    "rust/crates/downtime-core",
    "rust/crates/downtime-wasm",
    "rust/crates/downtime-native",
    "rust/crates/downtime-server",
    "rust/crates/downtime-cli",
    "rust/crates/globe-native",
    "rust/crates/rustle",
    "globalstatus",
    "globalstatus-wasm",
    "visualizer",
    "scripts",
    "docs"
  ],
  "exclude": [
    "node_modules",
    ".git",
    "dist",
    "build",
    "out",
    "coverage",
    "target",
    "vendor",
    ".context",
    "globalstatus/vendor",
    "globalstatus/data",
    "visualizer/public/vendor",
    "visualizer/data",
    "*.jsonl",
    "*.jpg",
    "*.png",
    "*.wasm"
  ],
  "maxDepth": 12,
  "maxSigsPerFile": 25,
  "autoMaxTokens": false,
  "maxTokens": 24000,
  "coverageTarget": 0.8,
  "secretScan": true,
  "monorepo": false,
  "depMap": true,
  "todos": true,
  "changes": true
}
